#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
python="$root/forge/audio/.venv/bin/python"
if [ ! -x "$python" ]; then
    echo '{"error":"Install the audio environment first (docs/audio.md)."}' >&2
    exit 1
fi
export PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}"
export HF_HOME="$root/models/audio/hf" XDG_CACHE_HOME="$root/models/audio/cache"
export HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1 HF_HUB_DISABLE_TELEMETRY=1
export TOKENIZERS_PARALLELISM=false TORCHDYNAMO_DISABLE=1
exec "$python" -m forge.audio music "$@"
