{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skills Reviewer Evals",
  "type": "object",
  "required": ["schema_version", "skill_under_test", "cases"],
  "properties": {
    "schema_version": {"type": "string"},
    "skill_under_test": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "fixture", "task", "expect"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "fixture": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "expect": {
            "type": "object",
            "properties": {
              "verdict": {"type": "string", "enum": ["Ready", "Ready with fixes", "Do not publish"]},
              "min_average_score": {"type": "number", "minimum": 0, "maximum": 5},
              "max_average_score": {"type": "number", "minimum": 0, "maximum": 5},
              "must_find_codes": {"type": "array", "items": {"type": "string"}},
              "must_not_find_codes": {"type": "array", "items": {"type": "string"}},
              "must_not_find_severities": {"type": "array", "items": {"type": "string"}}
            }
          }
        }
      }
    }
  }
}
