direction: down

# Matches ui/src/modules/loops/templates.ts: research.
# Node IDs and acceptance IDs match the editable template.
vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 0
    pad: 28
  }
}

title: "Research — suggested execution graph" {
  shape: text
  near: top-center
  style.font-size: 24
}

tasks: {
  label: "One task per goal-loop iteration"
  style.stroke: "#94a3b8"
  style.fill: "#f8fafc"
  task-1: "Collect evidence\ntask-1 · c1\nRelevant primary evidence and constraints are recorded." {
    style.fill: "#ffffff"
    style.stroke: "#475569"
    style.border-radius: 8
    style.font-size: 17
  }
  task-2: "Compare options\ntask-2 · c2\nOptions are compared against explicit decision criteria." {
    style.fill: "#ffffff"
    style.stroke: "#475569"
    style.border-radius: 8
    style.font-size: 17
  }
  task-3: "Write the recommendation\ntask-3 · c3 + otto-research-report\nCited recommendation and retained findings.md" {
    style.fill: "#ffffff"
    style.stroke: "#475569"
    style.border-radius: 8
    style.font-size: 17
  }
  task-1 -> task-2: "c1 accepted"
  task-2 -> task-3: "c2 accepted"
}

completion: "Completion review\nAll goal criteria need evidence" {
  shape: diamond
  style.fill: "#e0f2fe"
  style.stroke: "#0369a1"
}
retained: "Succeeded\nWork and proof remain available" {
  style.fill: "#dcfce7"
  style.stroke: "#15803d"
}
tasks.task-3 -> completion: "c3 and report check accepted"
completion -> retained: "review accepts"

notes: "Plan → Execute → Evaluate → Digest\nRepairs invalidate dependent tasks.\nEvidence and limits govern completion." {
  shape: text
  near: bottom-center
  style.font-size: 15
}
