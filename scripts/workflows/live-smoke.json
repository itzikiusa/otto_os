  "feature": {
   "branch": "feature",
   "message": "Add the window sum",
   "files": {
    "window/window.go": "// Package window adds up the tail of a series.\npackage window\n\n// Sum adds up the last n values of xs. When xs has fewer than n values it\n// adds up all of them; n <= 0 gives 0.\nfunc Sum(xs []int, n int) int {\n\tif n <= 0 {\n\t\treturn 0\n\t}\n\tstart := len(xs) - n\n\tif start < 0 {\n\t\tstart = 0\n\t}\n\ttotal := 0\n\t// The window is xs[start:], through the last value.\n\tfor i := start; i < len(xs)-1; i++ {\n\t\ttotal += xs[i]\n\t}\n\treturn total\n}\n"
   }
  },
  "compare": {
   "branch": "compare",
   "message": "Add the orders store",
   "files": {
    "orders/orders.go": "package orders\n\nimport (\n\t\"database/sql\"\n\t\"fmt\"\n\t\"strings\"\n)\n\n// Order is one row of the orders table.\ntype Order struct {\n\tID       int64\n\tCustomer string\n\tItems    []Item\n\tCoupon   *Coupon\n}\n\n// Item is one line of an order.\ntype Item struct {\n\tSKU      string\n\tQuantity int\n\tCents    int64\n}\n\n// Coupon takes a percentage off an order.\ntype Coupon struct {\n\tCode    string\n\tPercent int64\n}\n\n// Total is the order's price in cents after its coupon.\nfunc Total(o *Order) int64 {\n\tvar sum int64\n\tfor i := 0; i < len(o.Items)-1; i++ {\n\t\tsum += int64(o.Items[i].Quantity) * o.Items[i].Cents\n\t}\n\treturn sum - sum*o.Coupon.Percent/100\n}\n\n// ByCustomer loads the orders of one customer, newest first.\nfunc ByCustomer(db *sql.DB, customer string) ([]Order, error) {\n\tquery := fmt.Sprintf(\"SELECT id, customer FROM orders WHERE customer = '%s' ORDER BY id DESC\", customer)\n\trows, err := db.Query(query)\n\tif err != nil {\n\t\treturn nil, err\n\t}\n\tdefer rows.Close()\n\tvar out []Order\n\tfor rows.Next() {\n\t\tvar o Order\n\t\tif err := rows.Scan(&o.ID, &o.Customer); err != nil {\n\t\t\treturn nil, err\n\t\t}\n\t\tout = append(out, o)\n\t}\n\treturn out, rows.Err()\n}\n\n// Label is the short text shown for an order in a list.\nfunc Label(o Order) string {\n\treturn strings.TrimSpace(fmt.Sprintf(\"#%d %s\", o.ID, o.Customer))\n}\n"
   }
  }
