      "title": "Rooms · collaborate and recap",
      "music": "final",
      "startBar": 56,
      "bars": 8,
      "startFrame": 3360,
      "frames": 480,
      "lines": [
        {
          "text": "Start a room from a live session. The host admits who joins.",
          "start": 112.25,
          "end": 114.85
        },
        {
          "text": "Share a screen and talk it through.",
          "start": 115,
          "end": 117.85
        },
        {
          "text": "Teammates draw on the shared screen, with permission.",
          "start": 118,
          "end": 120.85
        },
        {
          "text": "Hand over terminal control, and take it back at any time.",
          "start": 121,
          "end": 123.85
        },
        {
          "text": "With everyone's consent, get a local recap: decisions and action items.",
          "start": 124,
          "end": 127.85
        }
