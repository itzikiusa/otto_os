  "totalFrames": 5640,
  "totalSeconds": 188,
  "chapters": [
    {
      "id": "intro",
      "section": "getting-started",
      "title": "Meet Otto",
      "music": "intro",
      "startBar": 0,
      "bars": 4,
      "startFrame": 0,
      "frames": 240,
      "lines": [
        {
          "text": "Your agents. Your repos. Your data. Your infrastructure.",
          "start": 0.25,
          "end": 3.85
        },
        {
          "text": "Otto: every coding agent, one native Mac app.",
          "start": 4,
          "end": 7.85
        }
      ]
    },
    {
      "id": "home",
      "section": "home",
      "title": "Home",
      "music": "chorus",
      "startBar": 4,
      "bars": 3,
      "startFrame": 240,
      "frames": 180,
      "lines": [
        {
          "text": "Home shows live sessions, dashboards, usage and findings.",
          "start": 8.25,
          "end": 10.85
        },
        {
          "text": "Light, dark and right-to-left, one design system.",
          "start": 11,
          "end": 13.85
        }
      ]
    },
    {
      "id": "command-bar",
      "section": "command-bar",
      "title": "The command bar",
      "music": null,
      "startBar": 7,
      "bars": 4,
      "startFrame": 420,
      "frames": 240,
      "lines": [
        {
          "text": "Press ⌘K, type or speak. Otto runs it or answers.",
          "start": 14.25,
          "end": 17.85
        },
        {
          "text": "⌥Space calls the bar from anywhere on your Mac.",
          "start": 18,
          "end": 21.85
        }
      ]
    },
    {
      "id": "agents",
      "section": "agents",
      "title": "Agents",
      "music": null,
      "startBar": 11,
      "bars": 6,
      "startFrame": 660,
      "frames": 360,
      "lines": [
        {
          "text": "Agents is one workspace: your sessions in an inbox beside the canvas, status in words.",
          "start": 22.25,
          "end": 27.85
        },
        {
          "text": "Switch a session between Terminal and Chat, tile it with the rest, or broadcast one prompt to many.",
          "start": 28,
          "end": 33.85
        }
      ]
    },
    {
      "id": "threads",
      "section": "threads",
      "title": "Threads",
      "music": null,
      "startBar": 17,
      "bars": 7,
      "startFrame": 1020,
      "frames": 420,
      "lines": [
        {
          "text": "Threads run every structured agent: Claude, Codex, Antigravity, OpenCode, pi, Gemini, Grok and Muse.",
          "start": 34.25,
          "end": 40.85
        },
        {
          "text": "Plans, commands and diffs stream live. Approve inline, or compare models side by side.",
          "start": 41,
          "end": 47.85
        }
      ]
    },
    {
      "id": "workflows",
      "section": "workflows",
      "title": "Workflows",
      "music": "verse",
      "startBar": 24,
      "bars": 9,
      "startFrame": 1440,
      "frames": 540,
      "lines": [
        {
          "text": "Workflows opens on Runs: what needs you, what is running and what just finished, in words.",
          "start": 48.25,
          "end": 49.85
        },
        {
          "text": "A run page lists every step in order. A review fans out to twelve named reviewers, each with its own conversation.",
          "start": 50,
          "end": 54.85
        },
        {
          "text": "A failed run leads with the step's own error and Retry step, on your Mac or your phone.",
          "start": 55,
          "end": 58.85
        },
        {
          "text": "Pick each step’s model and effort, as in Threads.",
          "start": 59,
          "end": 60.85
        },
        {
          "text": "A goal is a workflow too: it works until every criterion is checked and met.",
          "start": 61,
          "end": 64.35
        },
        {
          "text": "Optimize drafts a faster version; you apply it.",
          "start": 64.5,
          "end": 65.85
        }
      ]
    },
    {
      "id": "personal-agents",
      "section": "personal-agents",
      "title": "Personal Agents",
      "music": null,
      "startBar": 33,
      "bars": 3,
      "startFrame": 1980,
      "frames": 180,
      "lines": [
        {
          "text": "A personal agent's Chat is a thread on the same runtime, with its tools and routines.",
          "start": 66.25,
          "end": 69.85
        },
        {
          "text": "Scheduled tasks run agents on a cadence and report back.",
          "start": 70,
          "end": 71.85
        }
      ]
    },
    {
      "id": "ide",
      "section": "ide",
      "title": "IDE (Beta)",
      "music": "chorus",
      "startBar": 36,
      "bars": 6,
      "startFrame": 2160,
      "frames": 360,
      "lines": [
        {
          "text": "The IDE keeps your projects in the order you added them, and brings back every tab after a restart.",
          "start": 72.25,
          "end": 75.85
        },
        {
          "text": "Type with the language server beside you, run a test configuration and see the results.",
          "start": 76,
          "end": 79.85
        },
        {
          "text": "Debug with breakpoints, frames and variables, or ask the agent about the selected code.",
          "start": 80,
          "end": 83.85
        }
      ]
    },
    {
      "id": "agent-debug",
      "section": "ide",
      "title": "Debug with an agent",
      "music": null,
      "startBar": 42,
      "bars": 6,
      "startFrame": 2520,
      "frames": 360,
      "lines": [
        {
          "text": "Ask an agent to debug with Otto. Before anything runs, you see exactly what it will start.",
          "start": 84.25,
          "end": 87.85
        },
        {
          "text": "Its breakpoints are marked as its own. At every stop it says what the values show, and waits.",
          "start": 88,
          "end": 91.85
        },
        {
          "text": "Press Proceed to let it go on, or use the debugger yourself to take over.",
          "start": 92,
          "end": 95.85
        }
      ]
    },
    {
      "id": "dbwatch",
      "section": "ide",
      "title": "DB Watch",
      "music": null,
      "startBar": 48,
      "bars": 2,
      "startFrame": 2880,
      "frames": 120,
      "lines": [
        {
          "text": "DB Watch shows the rows your code wrote at every stop: changed cells only, before → after.",
          "start": 96.25,
          "end": 99.85
        }
      ]
    },
    {
      "id": "git",
      "section": "git",
      "title": "Git and AI review",
      "music": null,
      "startBar": 50,
      "bars": 4,
      "startFrame": 3000,
      "frames": 240,
      "lines": [
        {
          "text": "Git opens on History. Your uncommitted changes are its top row.",
          "start": 100.25,
          "end": 103.85
        },
        {
          "text": "Stage, commit and draft the message there. Multi-agent review turns findings into tracked fixes.",
          "start": 104,
          "end": 107.85
        }
      ]
    },
    {
      "id": "product",
      "section": "product",
      "title": "Product and Design Hall",
      "music": null,
      "startBar": 54,
      "bars": 4,
      "startFrame": 3240,
      "frames": 240,
      "lines": [
        {
          "text": "A story's Design tab lists the designs that implement it.",
          "start": 108.25,
          "end": 111.85
        },
        {
          "text": "Design Hall is the one home for designs: versions, compare, approve, and comments pinned on the design.",
          "start": 112,
          "end": 115.85
        }
      ]
    },
    {
      "id": "vault",
      "section": "vault",
      "title": "Vault and Skills Lab",
      "music": null,
      "startBar": 58,
      "bars": 2,
      "startFrame": 3480,
      "frames": 120,
      "lines": [
        {
          "text": "The Vault links your docs with backlinks. Skills Lab is the one home for agent skills.",
          "start": 116.25,
          "end": 119.85
        }
      ]
    },
    {
      "id": "database",
      "section": "database",
      "title": "Database Explorer",
      "music": "verse",
      "startBar": 60,
      "bars": 4,
      "startFrame": 3600,
      "frames": 240,
      "lines": [
        {
          "text": "Query MySQL, Postgres, MongoDB, Redis and ClickHouse.",
          "start": 120.25,
          "end": 123.85
        },
        {
          "text": "A read-only connection refuses writes. History spans every connection.",
          "start": 124,
          "end": 127.85
        }
      ]
    },
    {
      "id": "infra",
      "section": "connections",
      "title": "Connections and cloud",
      "music": null,
      "startBar": 64,
      "bars": 4,
      "startFrame": 3840,
      "frames": 240,
      "lines": [
        {
          "text": "SSH, AWS, Kubernetes, APIs and the web.",
          "start": 128.25,
          "end": 131.85
        },
        {
          "text": "An MCP server that runs through Otto can be available in every workspace, with one set of credentials.",
          "start": 132,
          "end": 135.85
        }
      ]
    },
    {
      "id": "insights",
      "section": "insights",
      "title": "Insights and Usage",
      "music": "breakdown",
      "startBar": 68,
      "bars": 4,
      "startFrame": 4080,
      "frames": 240,
      "lines": [
        {
          "text": "Insights turns your activity into key findings.",
          "start": 136.25,
          "end": 139.85
        },
        {
          "text": "Usage shows what is left on each plan, per login.",
          "start": 140,
          "end": 143.85
        }
      ]
    },
    {
      "id": "rooms",
      "section": "rooms",
      "title": "Rooms · collaborate and recap",
      "music": "final",
      "startBar": 72,
      "bars": 8,
      "startFrame": 4320,
      "frames": 480,
      "lines": [
        {
          "text": "Start a room from a live session. The host admits who joins.",
          "start": 144.25,
          "end": 146.85
        },
        {
          "text": "Share a screen and talk it through.",
          "start": 147,
          "end": 149.85
        },
        {
          "text": "Teammates draw on the shared screen, with permission.",
          "start": 150,
          "end": 152.85
        },
        {
          "text": "Hand over terminal control, and take it back at any time.",
          "start": 153,
          "end": 155.85
        },
        {
          "text": "With everyone's consent, get a local recap: decisions and action items.",
          "start": 156,
          "end": 159.85
        }
      ]
    },
    {
      "id": "phone",
      "section": "phone-and-remote",
      "title": "Phone access",
      "music": null,
      "startBar": 80,
      "bars": 4,
      "startFrame": 4800,
      "frames": 240,
      "lines": [
        {
          "text": "Continue on phone: scan, approve the match on your Mac, and the thread opens.",
          "start": 160.25,
          "end": 163.85
        },
        {
          "text": "Or switch the phone to the light version: five tabs, one tap back.",
          "start": 164,
          "end": 167.85
        }
      ]
    },
    {
      "id": "updates",
      "section": "desktop-app",
      "title": "Updates",
      "music": null,
      "startBar": 84,
      "bars": 4,
      "startFrame": 5040,
      "frames": 240,
      "lines": [
        {
          "text": "Check for Updates… shows what is new and downloads the new version.",
          "start": 168.25,
          "end": 171.85
        },
        {
          "text": "Restart to finish: Otto lists what keeps running first.",
          "start": 172,
          "end": 175.85
        }
      ]
    },
    {
      "id": "outro",
      "section": "channels",
      "title": "Everywhere",
      "music": "outro",
      "startBar": 88,
      "bars": 6,
      "startFrame": 5280,
      "frames": 360,
      "lines": [
        {
          "text": "Snip the screen, bridge Slack and Telegram, and take Otto with you.",
          "start": 176.25,
          "end": 181.85
        },
        {
          "text": "Otto. All your agents, one home.",
          "start": 182,
          "end": 187.85
        }
      ]
    }
  ]
}
