  "chapters": [
    {
      "id": "intro",
      "section": "getting-started",
      "title": "Meet Otto",
      "music": "intro",
      "startBar": 0,
      "bars": 4,
      "startFrame": 0,
      "frames": 240,
      "lines": [
        {
          "text": "Your agents. Your repos. Your data. Your infrastructure.",
          "start": 0.25,
          "end": 3.85
        },
        {
          "text": "Otto: every coding agent, one native Mac app.",
          "start": 4,
          "end": 7.85
        }
      ]
    },
    {
      "id": "home",
      "section": "home",
      "title": "Home",
      "music": "chorus",
      "startBar": 4,
      "bars": 3,
      "startFrame": 240,
      "frames": 180,
      "lines": [
        {
          "text": "Home shows live sessions, dashboards, usage and findings.",
          "start": 8.25,
          "end": 10.85
        },
        {
          "text": "Light, dark and right-to-left, one design system.",
          "start": 11,
          "end": 13.85
        }
      ]
    },
    {
      "id": "command-bar",
      "section": "command-bar",
      "title": "The command bar",
      "music": null,
      "startBar": 7,
      "bars": 4,
      "startFrame": 420,
      "frames": 240,
      "lines": [
        {
          "text": "Press ⌘K, type or speak. Otto runs it or answers.",
          "start": 14.25,
          "end": 17.85
        },
        {
          "text": "⌥Space calls the bar from anywhere on your Mac.",
          "start": 18,
          "end": 21.85
        }
      ]
    },
    {
      "id": "agents",
      "section": "agents",
      "title": "Agents",
      "music": null,
      "startBar": 11,
      "bars": 5,
      "startFrame": 660,
      "frames": 300,
      "lines": [
        {
          "text": "Claude Code, Codex, Antigravity and shells run as real sessions.",
          "start": 22.25,
          "end": 26.85
        },
        {
          "text": "Tile up to 15 live terminals, or broadcast one prompt to many.",
          "start": 27,
          "end": 31.85
        }
      ]
    },
    {
      "id": "threads",
      "section": "threads",
      "title": "Threads",
      "music": null,
      "startBar": 16,
      "bars": 6,
      "startFrame": 960,
      "frames": 360,
      "lines": [
        {
          "text": "Threads run your agents on the structured runtime: plans, commands and diffs stream live.",
          "start": 32.25,
          "end": 37.85
        },
        {
          "text": "Approve right where the agent asks, and pick the thread up on your phone.",
          "start": 38,
          "end": 43.85
        }
      ]
    },
    {
      "id": "loops",
      "section": "loops",
      "title": "Goal Loops",
      "music": "verse",
      "startBar": 22,
      "bars": 3,
      "startFrame": 1320,
      "frames": 180,
      "lines": [
        {
          "text": "Give a goal and acceptance checks.",
          "start": 44.25,
          "end": 46.85
        },
        {
          "text": "Goal loops plan, execute and evaluate until every check passes.",
          "start": 47,
          "end": 49.85
        }
      ]
    },
    {
      "id": "workflows",
      "section": "workflows",
      "title": "Workflows and Scheduled Tasks",
      "music": null,
      "startBar": 25,
      "bars": 4,
      "startFrame": 1500,
      "frames": 240,
      "lines": [
        {
          "text": "Workflows chain agents, approvals and tools.",
          "start": 50.25,
          "end": 53.85
        },
        {
          "text": "Scheduled tasks run agents on a cadence and report back.",
          "start": 54,
          "end": 57.85
        }
      ]
    },
    {
      "id": "personal-agents",
      "section": "personal-agents",
      "title": "Personal Agents",
      "music": null,
      "startBar": 29,
      "bars": 4,
      "startFrame": 1740,
      "frames": 240,
      "lines": [
        {
          "text": "A personal agent's Chat is a thread on the same runtime, with its tools.",
          "start": 58.25,
          "end": 61.85
        },
        {
          "text": "A main agent delegates to its team and gets their reports back.",
          "start": 62,
          "end": 65.85
        }
      ]
    },
    {
      "id": "git",
      "section": "git",
      "title": "Git and AI review",
      "music": "chorus",
      "startBar": 33,
      "bars": 4,
      "startFrame": 1980,
      "frames": 240,
      "lines": [
        {
          "text": "A commit graph with your work in progress and pull requests.",
          "start": 66.25,
          "end": 69.85
        },
        {
          "text": "Multi-agent code review turns findings into tracked fixes.",
          "start": 70,
          "end": 73.85
        }
      ]
    },
    {
      "id": "product",
      "section": "product",
      "title": "Product and Design Hall",
      "music": null,
      "startBar": 37,
      "bars": 5,
      "startFrame": 2220,
      "frames": 300,
      "lines": [
        {
          "text": "Product unites stories, designs and learnings in one hub.",
          "start": 74.25,
          "end": 78.85
        },
        {
          "text": "Frames, 3D, sites and brand kits live in one versioned library.",
          "start": 79,
          "end": 83.85
        }
      ]
    },
    {
      "id": "vault",
      "section": "vault",
      "title": "Vault and Skills Lab",
      "music": null,
      "startBar": 42,
      "bars": 3,
      "startFrame": 2520,
      "frames": 180,
      "lines": [
        {
          "text": "The Vault links your markdown docs into a live knowledge graph.",
          "start": 84.25,
          "end": 86.85
        },
        {
          "text": "Skills Lab reviews, benchmarks and sharpens your agent skills.",
          "start": 87,
          "end": 89.85
        }
      ]
    },
    {
      "id": "database",
      "section": "database",
      "title": "Database Explorer",
      "music": "verse",
      "startBar": 45,
      "bars": 4,
      "startFrame": 2700,
      "frames": 240,
      "lines": [
        {
          "text": "MySQL, Postgres, MongoDB, Redis and ClickHouse.",
          "start": 90.25,
          "end": 93.85
        },
        {
          "text": "Build a query visually and watch agent MCP queries live.",
          "start": 94,
          "end": 97.85
        }
      ]
    },
    {
      "id": "infra",
      "section": "connections",
      "title": "Connections and cloud",
      "music": null,
      "startBar": 49,
      "bars": 4,
      "startFrame": 2940,
      "frames": 240,
      "lines": [
        {
          "text": "SSH, Kafka, AWS, Kubernetes, APIs and the web.",
          "start": 98.25,
          "end": 101.85
        },
        {
          "text": "Every agent tool call goes through the MCP control plane.",
          "start": 102,
          "end": 105.85
        }
      ]
    },
    {
      "id": "insights",
      "section": "insights",
      "title": "Insights and Usage",
      "music": "breakdown",
      "startBar": 53,
      "bars": 4,
      "startFrame": 3180,
      "frames": 240,
      "lines": [
        {
          "text": "Insights turns your activity into key findings.",
          "start": 106.25,
          "end": 109.85
        },
        {
          "text": "Usage tracks tokens, cost and machine load.",
          "start": 110,
          "end": 113.85
        }
      ]
    },
    {
      "id": "rooms",
      "section": "rooms",
      "title": "Rooms · collaborate and recap",
      "music": "final",
      "startBar": 57,
      "bars": 8,
      "startFrame": 3420,
      "frames": 480,
      "lines": [
        {
          "text": "Start a room from a live session. The host admits who joins.",
          "start": 114.25,
          "end": 116.85
        },
        {
          "text": "Share a screen and talk it through.",
          "start": 117,
          "end": 119.85
        },
        {
          "text": "Teammates draw on the shared screen, with permission.",
          "start": 120,
          "end": 122.85
        },
        {
          "text": "Hand over terminal control, and take it back at any time.",
          "start": 123,
          "end": 125.85
        },
        {
          "text": "With everyone's consent, get a local recap: decisions and action items.",
          "start": 126,
          "end": 129.85
        }
      ]
    },
    {
      "id": "phone",
      "section": "phone-and-remote",
      "title": "Phone access",
      "music": null,
      "startBar": 65,
      "bars": 4,
      "startFrame": 3900,
      "frames": 240,
      "lines": [
        {
          "text": "Phone access serves Otto to your tailnet only, through Tailscale.",
          "start": 130.25,
          "end": 133.85
        },
        {
          "text": "Scan the code, approve the match on your Mac, and your thread continues on the phone.",
          "start": 134,
          "end": 137.85
        }
      ]
    },
    {
      "id": "outro",
      "section": "channels",
      "title": "Everywhere",
      "music": "outro",
      "startBar": 69,
      "bars": 6,
      "startFrame": 4140,
      "frames": 360,
      "lines": [
        {
          "text": "Snip the screen, bridge Slack and Telegram, and take Otto with you.",
          "start": 138.25,
          "end": 143.85
        },
        {
          "text": "Otto. All your agents, one home.",
          "start": 144,
          "end": 149.85
        }
      ]
    }
  ]
}
