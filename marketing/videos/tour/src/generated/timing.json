      "music": "chorus",
      "startBar": 4,
      "bars": 3,
      "startFrame": 240,
      "frames": 180,
      "lines": [
        {
          "text": "Home shows what needs you, what's running and what's next.",
          "start": 8.25,
          "end": 10.85
        },
        {
          "text": "Light or dark, one design system.",
          "start": 11,
          "end": 13.85
        }
