      "music": null,
      "startBar": 7,
      "bars": 4,
      "startFrame": 420,
      "frames": 240,
      "lines": [
        {
          "text": "Press ⌘K, type or speak. Otto runs it or answers.",
          "start": 14.25,
          "end": 17.85
