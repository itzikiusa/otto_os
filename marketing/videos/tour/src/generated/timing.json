  "chapters": [
    {
      "id": "intro",
      "section": "getting-started",
      "title": "Meet Otto",
      "music": "intro",
      "startBar": 0,
      "bars": 4,
      "startFrame": 0,
      "frames": 240,
      "lines": [
        {
          "text": "Your agents. Your repos. Your data. Your infrastructure.",
          "start": 0.25,
          "end": 3.85
        },
        {
          "text": "Otto: every coding agent, one native Mac app.",
          "start": 4,
          "end": 7.85
        }
      ]
    },
    {
      "id": "home",
      "section": "home",
      "title": "Home",
      "music": "chorus",
      "startBar": 4,
      "bars": 3,
      "startFrame": 240,
      "frames": 180,
      "lines": [
        {
          "text": "Home shows live sessions, dashboards, usage and findings.",
          "start": 8.25,
          "end": 10.85
        },
        {
          "text": "Light, dark and right-to-left, one design system.",
          "start": 11,
          "end": 13.85
        }
      ]
    },
    {
      "id": "command-bar",
      "section": "command-bar",
      "title": "The command bar",
      "music": null,
      "startBar": 7,
      "bars": 4,
      "startFrame": 420,
      "frames": 240,
      "lines": [
        {
          "text": "Press ⌘K, type or speak. Otto runs it or answers.",
          "start": 14.25,
          "end": 17.85
        },
        {
          "text": "⌥Space calls the bar from anywhere on your Mac.",
          "start": 18,
          "end": 21.85
        }
      ]
    },
    {
      "id": "agents",
      "section": "agents",
      "title": "Agents",
      "music": null,
      "startBar": 11,
      "bars": 3,
      "startFrame": 660,
      "frames": 180,
      "lines": [
        {
          "text": "Claude Code, Codex, Antigravity and shells run as real sessions.",
          "start": 22.25,
          "end": 24.85
        },
        {
          "text": "Tile live terminals, or broadcast one prompt to many.",
          "start": 25,
          "end": 27.85
        }
      ]
    },
    {
      "id": "threads",
      "section": "threads",
      "title": "Threads",
      "music": null,
      "startBar": 14,
      "bars": 6,
      "startFrame": 840,
      "frames": 360,
      "lines": [
        {
          "text": "Threads run every structured agent: Claude, Codex, Gemini, Grok, OpenCode, pi, Muse and more.",
          "start": 28.25,
          "end": 33.85
        },
        {
          "text": "Plans, commands and diffs stream live. Approve inline, or ask another agent from inside the thread.",
          "start": 34,
          "end": 39.85
        }
      ]
    },
    {
      "id": "council",
      "section": "threads",
      "title": "Council",
      "music": null,
      "startBar": 20,
      "bars": 4,
      "startFrame": 1200,
      "frames": 240,
      "lines": [
        {
          "text": "Council sends one prompt to several agents, side by side.",
          "start": 40.25,
          "end": 43.85
        },
        {
          "text": "A judge compares the answers. A follow-up goes to every seat as round 2.",
          "start": 44,
          "end": 47.85
        }
      ]
    },
    {
      "id": "loops",
      "section": "loops",
      "title": "Goal Loops",
      "music": "verse",
      "startBar": 24,
      "bars": 4,
      "startFrame": 1440,
      "frames": 240,
      "lines": [
        {
          "text": "Give a goal and acceptance checks.",
          "start": 48.25,
          "end": 51.85
        },
        {
          "text": "Goal loops plan, execute and evaluate until every check passes.",
          "start": 52,
          "end": 55.85
        }
      ]
    },
    {
      "id": "workflows",
      "section": "workflows",
      "title": "Workflows and Scheduled Tasks",
      "music": null,
      "startBar": 28,
      "bars": 4,
      "startFrame": 1680,
      "frames": 240,
      "lines": [
        {
          "text": "Workflows chain agents, approvals and tools.",
          "start": 56.25,
          "end": 59.85
        },
        {
          "text": "Scheduled tasks run agents on a cadence and report back.",
          "start": 60,
          "end": 63.85
        }
      ]
    },
    {
      "id": "personal-agents",
      "section": "personal-agents",
      "title": "Personal Agents",
      "music": null,
      "startBar": 32,
      "bars": 4,
      "startFrame": 1920,
      "frames": 240,
      "lines": [
        {
          "text": "A personal agent's Chat is a thread on the same runtime, with its tools.",
          "start": 64.25,
          "end": 67.85
        },
        {
          "text": "Each agent runs its routines on a schedule and reports back.",
          "start": 68,
          "end": 71.85
        }
      ]
    },
    {
      "id": "ide",
      "section": "ide",
      "title": "IDE (Beta)",
      "music": "chorus",
      "startBar": 36,
      "bars": 8,
      "startFrame": 2160,
      "frames": 480,
      "lines": [
        {
          "text": "The IDE (Beta) opens your multi-language project. The git gutter marks your changes; the language server adds docs.",
          "start": 72.25,
          "end": 76.85
        },
        {
          "text": "Type errors show as you read. Run configurations stream their output and a test tree.",
          "start": 77,
          "end": 81.85
        },
        {
          "text": "Set a breakpoint and debug: frames, variables, evaluate.",
          "start": 82,
          "end": 84.85
        },
        {
          "text": "Ask the agent beside your code, then apply its diff or undo it.",
          "start": 85,
          "end": 87.85
        }
      ]
    },
    {
      "id": "git",
      "section": "git",
      "title": "Git and AI review",
      "music": null,
      "startBar": 44,
      "bars": 4,
      "startFrame": 2640,
      "frames": 240,
      "lines": [
        {
          "text": "A commit graph with your work in progress and pull requests.",
          "start": 88.25,
          "end": 91.85
        },
        {
          "text": "Multi-agent code review turns findings into tracked fixes.",
          "start": 92,
          "end": 95.85
        }
      ]
    },
    {
      "id": "product",
      "section": "product",
      "title": "Product and Design Hall",
      "music": null,
      "startBar": 48,
      "bars": 5,
      "startFrame": 2880,
      "frames": 300,
      "lines": [
        {
          "text": "A story's Design tab lists the designs that implement it.",
          "start": 96.25,
          "end": 100.85
        },
        {
          "text": "Design Hall is the one home for designs: versions, compare, approve, and comments pinned on the design.",
          "start": 101,
          "end": 105.85
        }
      ]
    },
    {
      "id": "vault",
      "section": "vault",
      "title": "Vault and Skills Lab",
      "music": null,
      "startBar": 53,
      "bars": 3,
      "startFrame": 3180,
      "frames": 180,
      "lines": [
        {
          "text": "The Vault links your markdown docs with backlinks and live context.",
          "start": 106.25,
          "end": 108.85
        },
        {
          "text": "Skills Lab is the one home for your agent skills.",
          "start": 109,
          "end": 111.85
        }
      ]
    },
    {
      "id": "database",
      "section": "database",
      "title": "Database Explorer",
      "music": "verse",
      "startBar": 56,
      "bars": 4,
      "startFrame": 3360,
      "frames": 240,
      "lines": [
        {
          "text": "Query MySQL, Postgres, MongoDB, Redis and ClickHouse.",
          "start": 112.25,
          "end": 115.85
        },
        {
          "text": "A read-only connection refuses writes. History spans every connection.",
          "start": 116,
          "end": 119.85
        }
      ]
    },
    {
      "id": "infra",
      "section": "connections",
      "title": "Connections and cloud",
      "music": null,
      "startBar": 60,
      "bars": 4,
      "startFrame": 3600,
      "frames": 240,
      "lines": [
        {
          "text": "SSH, AWS, Kubernetes, APIs and the web.",
          "start": 120.25,
          "end": 123.85
        },
        {
          "text": "MCP servers run native or governed. A dangerous tool call waits for a person.",
          "start": 124,
          "end": 127.85
        }
      ]
    },
    {
      "id": "insights",
      "section": "insights",
      "title": "Insights and Usage",
      "music": "breakdown",
      "startBar": 64,
      "bars": 4,
      "startFrame": 3840,
      "frames": 240,
      "lines": [
        {
          "text": "Insights turns your activity into key findings.",
          "start": 128.25,
          "end": 131.85
        },
        {
          "text": "Usage shows what is left on each plan, per login.",
          "start": 132,
          "end": 135.85
        }
      ]
    },
    {
      "id": "rooms",
      "section": "rooms",
      "title": "Rooms · collaborate and recap",
      "music": "final",
      "startBar": 68,
      "bars": 8,
      "startFrame": 4080,
      "frames": 480,
      "lines": [
        {
          "text": "Start a room from a live session. The host admits who joins.",
          "start": 136.25,
          "end": 138.85
        },
        {
          "text": "Share a screen and talk it through.",
          "start": 139,
          "end": 141.85
        },
        {
          "text": "Teammates draw on the shared screen, with permission.",
          "start": 142,
          "end": 144.85
        },
        {
          "text": "Hand over terminal control, and take it back at any time.",
          "start": 145,
          "end": 147.85
        },
        {
          "text": "With everyone's consent, get a local recap: decisions and action items.",
          "start": 148,
          "end": 151.85
        }
      ]
    },
    {
      "id": "phone",
      "section": "phone-and-remote",
      "title": "Phone access",
      "music": null,
      "startBar": 76,
      "bars": 4,
      "startFrame": 4560,
      "frames": 240,
      "lines": [
        {
          "text": "Continue on phone: scan, approve the match on your Mac, and the thread opens.",
          "start": 152.25,
          "end": 155.85
        },
        {
          "text": "Or switch the phone to the light version: five tabs, one tap back.",
          "start": 156,
          "end": 159.85
        }
      ]
    },
    {
      "id": "outro",
      "section": "channels",
      "title": "Everywhere",
      "music": "outro",
      "startBar": 80,
      "bars": 6,
      "startFrame": 4800,
      "frames": 360,
      "lines": [
        {
          "text": "Snip the screen, bridge Slack and Telegram, and take Otto with you.",
          "start": 160.25,
          "end": 165.85
        },
        {
          "text": "Otto. All your agents, one home.",
          "start": 166,
          "end": 171.85
        }
      ]
    }
  ]
}
