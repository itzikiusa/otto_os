<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd user-agent template for the Otto daemon.
     The installer replaces __OTTOD_PATH__ with the absolute path of the
     installed ottod binary and __LOG_DIR__ with ~/Library/Logs/Otto (absolute)
     before `launchctl bootstrap gui/$UID <plist>`. Keep in sync with the
     plist apps/desktop/src-tauri/src/supervisor.rs installs. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.otto.daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>__OTTOD_PATH__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <!-- Interactive, not Background: Background (darwinbg, efficiency
         cores, throttled I/O, timer coalescing) is inherited by every PTY
         child and turns keystroke echo into second-scale lag. Keep in sync
         with the plist apps/desktop/src-tauri/src/supervisor.rs installs. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <!-- SIGKILL this long after SIGTERM. ottod's worst-case stop is ~24 s:
         a 3 s HTTP drain, an 18 s teardown deadline shared by every step
         (ClickHouse's flush slot reserved) and a 2 s runtime shutdown. -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <!-- Panics/aborts land on stderr before the tracing file sees them. -->
    <key>StandardOutPath</key>
    <string>__LOG_DIR__/ottod.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/ottod.stderr.log</string>
</dict>
</plist>
